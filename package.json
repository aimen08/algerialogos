{
  "name": "algerialogos",
  "version": "1.0.0",
  "description": "an open source website for downloading high quality",
  "main": "index.html",
"scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "sass scss/main.scss css/main.css --no-source-map",
    "watch": "npm run build && sass scss/main.scss css/main.css --watch --no-source-map",
    "serve": "live-server --host=localhost",
    "dev": "npm run serve",
    "format:js": "prettier --write",
    "lint:js:fix": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aimen08/algerialogos"
  },
  "author": "Aymen Hamza",
  "bugs": {
    "url": "http://algerialogos.com/"
  },
  "homepage": "http://algerialogos.com/",
  "devDependencies": {
    "eslint": "^6.1.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-config-prettier": "^6.3.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-prettier": "^3.1.0",
    "husky": "^3.0.5",
    "lint-staged": "^9.2.5",
    "live-server": "^1.2.1",
    "npm-run-all": "^4.1.5",
    "prettier": "1.18.2",
    "sass": "^1.79.0"
  },
  "lint-staged": {
    "*.js": [
      "npm run format:js",
      "npm run lint:js:fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
